# Server settings
HOST=0.0.0.0
PORT=3000

# Public URL of your deployment (Railway domain or custom domain)
PUBLIC_BASE_URL=https://your-app-name.up.railway.app

# Where Telegram session files are stored
SESSION_DIR=sessions

# Where app data/log files are stored (credentials log + api-phone map)
DATA_DIR=data

# Max linked accounts allowed for one API ID + API Hash pair
MAX_ACCOUNTS_PER_API=4
